{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "custom": false,
      "customGradient": false,
      "palette": [
        {
          "slug": "paper-000",
          "name": "Hvid",
          "color": "#ffffff"
        },
        {
          "slug": "paper-050",
          "name": "Creme",
          "color": "#faf7f1"
        },
        {
          "slug": "paper-100",
          "name": "Linned",
          "color": "#f3ede3"
        },
        {
          "slug": "paper-200",
          "name": "Havre",
          "color": "#e8dfd1"
        },
        {
          "slug": "paper-300",
          "name": "Sand",
          "color": "#dacdb9"
        },
        {
          "slug": "latte-400",
          "name": "Latte lys",
          "color": "#c9b295"
        },
        {
          "slug": "latte-500",
          "name": "Latte",
          "color": "#b2946f"
        },
        {
          "slug": "wood-600",
          "name": "Eg",
          "color": "#98764f"
        },
        {
          "slug": "wood-700",
          "name": "Valnød",
          "color": "#75593b"
        },
        {
          "slug": "cocoa-800",
          "name": "Kakao",
          "color": "#4a3428"
        },
        {
          "slug": "cocoa-900",
          "name": "Chokolade",
          "color": "#2e211a"
        },
        {
          "slug": "espresso-950",
          "name": "Espresso",
          "color": "#1b1310"
        },
        {
          "slug": "sage-500",
          "name": "Salvie",
          "color": "#8a9481"
        },
        {
          "slug": "sage-200",
          "name": "Salvie lys",
          "color": "#ccd2c3"
        },
        {
          "slug": "copper-500",
          "name": "Kobber",
          "color": "#a9603c"
        },
        {
          "slug": "copper-200",
          "name": "Kobber lys",
          "color": "#e6c9b7"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": false,
      "customFontSize": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Source Sans 3 (UI og brødtekst)",
          "fontFamily": "\"Source Sans 3\",\"Segoe UI\",system-ui,sans-serif",
          "fontFace": [
            {
              "fontFamily": "Source Sans 3",
              "fontWeight": "300 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/SourceSans3-Variable.woff2"
              ]
            },
            {
              "fontFamily": "Source Sans 3",
              "fontWeight": "300 700",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/SourceSans3-Italic-Variable.woff2"
              ]
            }
          ]
        },
        {
          "slug": "serif",
          "name": "Source Serif 4 (overskrifter)",
          "fontFamily": "\"Source Serif 4\",Georgia,serif",
          "fontFace": [
            {
              "fontFamily": "Source Serif 4",
              "fontWeight": "300 700",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/SourceSerif4-Variable.woff2"
              ]
            },
            {
              "fontFamily": "Source Serif 4",
              "fontWeight": "300 600",
              "fontStyle": "italic",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/SourceSerif4-Italic-Variable.woff2"
              ]
            }
          ]
        },
        {
          "slug": "display",
          "name": "Anton (display)",
          "fontFamily": "Anton,Haettenschweiler,\"Arial Narrow\",sans-serif",
          "fontFace": [
            {
              "fontFamily": "Anton",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/Anton-Regular.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "2xs",
          "name": "2XS",
          "size": "11px"
        },
        {
          "slug": "xs",
          "name": "XS",
          "size": "12px"
        },
        {
          "slug": "sm",
          "name": "S",
          "size": "14px"
        },
        {
          "slug": "base",
          "name": "Brødtekst",
          "size": "17px"
        },
        {
          "slug": "md",
          "name": "M",
          "size": "19px"
        },
        {
          "slug": "lg",
          "name": "L",
          "size": "22px"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "28px"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "36px"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "46px"
        },
        {
          "slug": "4xl",
          "name": "4XL",
          "size": "60px"
        },
        {
          "slug": "5xl",
          "name": "5XL",
          "size": "78px"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "1 · 16px",
          "size": "16px"
        },
        {
          "slug": "30",
          "name": "2 · 24px",
          "size": "24px"
        },
        {
          "slug": "40",
          "name": "3 · 32px",
          "size": "32px"
        },
        {
          "slug": "50",
          "name": "4 · 40px",
          "size": "40px"
        },
        {
          "slug": "60",
          "name": "5 · 64px",
          "size": "64px"
        },
        {
          "slug": "70",
          "name": "6 · 80px",
          "size": "80px"
        },
        {
          "slug": "80",
          "name": "7 · 96px",
          "size": "96px"
        },
        {
          "slug": "90",
          "name": "8 · 128px",
          "size": "128px"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "sm",
          "name": "Lav",
          "shadow": "0 1px 2px rgba(46,33,26,.08)"
        },
        {
          "slug": "md",
          "name": "Løftet",
          "shadow": "0 6px 18px -8px rgba(46,33,26,.14)"
        },
        {
          "slug": "lg",
          "name": "Dialog",
          "shadow": "0 18px 40px -18px rgba(46,33,26,.14)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper-050)",
      "text": "var(--wp--preset--color--cocoa-900)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.62"
    },
    "spacing": {
      "blockGap": "32px",
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "32px",
        "right": "32px"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--cocoa-800)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--copper-500)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "400",
          "lineHeight": "1.22",
          "letterSpacing": "-0.005em"
        },
        "color": {
          "text": "var(--wp--preset--color--espresso-950)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3xl)",
          "lineHeight": "1.15"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2xl)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--lg)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--md)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--espresso-950)",
          "text": "var(--wp--preset--color--paper-050)"
        },
        "border": {
          "radius": "4px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "600",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase"
        },
        "spacing": {
          "padding": {
            "top": "14px",
            "bottom": "14px",
            "left": "24px",
            "right": "24px"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--cocoa-800)",
            "text": "var(--wp--preset--color--paper-050)"
          }
        }
      }
    },
    "blocks": {
      "core/quote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "var(--wp--preset--font-size--xl)"
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "var(--wp--preset--font-size--lg)"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--paper-200)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header (annoncestribe + ankernavigation)",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer (fem kolonner + mærker)",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-fullwidth",
      "title": "Side uden titel (fuld bredde)",
      "postTypes": [
        "page"
      ]
    }
  ]
}